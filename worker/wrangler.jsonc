{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cercol-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 4 * * *", "0 5 * * *", "0 3 * * SUN", "0 4 * * SUN", "0 9 * * MON"] },
  "kv_namespaces": [
    { "binding": "NORMS", "id": "34d45ee221ff417d83b2bead1dc20f26" }
  ],
  "vars": {
    "FRONTEND_URL": "https://cercol.team",
    "BACKEND_URL": "https://api.cercol.team",
    // Issue queues (daily brief, plan steps) and the plan itself live in the
    // private ops repo since 2026-08-24; the public repo keeps code + science.
    "GITHUB_REPO": "Cercol/cercol-ops",
    "OPS_REPO": "Cercol/cercol-ops",
    // Cold outreach (ops plan t76): the routine prepares drafts in the ops
    // repo, outreach-tick sends them. Enabled 2026-08-25 on the operator's
    // explicit go; every draft still waits 24 h in the queue (the veto).
    "OUTREACH_ENABLED": "0"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cercol", "database_id": "928ddbd6-5fc6-4e2b-9fd1-e7de66435ef6" }
  ]
}
